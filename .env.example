# Copie este arquivo para ".env" (na mesma pasta) se quiser mudar algum valor.
# O arquivo .env NÃO vai para o GitHub. Sem ele, valem os valores abaixo.
# Estes valores servem só para desenvolvimento no seu computador.

RESTON_DB_NOME=reston
RESTON_DB_USUARIO=reston
RESTON_DB_SENHA=reston_dev
RESTON_DB_PORT=5432

# Primeiro administrador (opcional). Se a senha ficar vazia, uma provisória é gerada e mostrada uma vez no log da API.
RESTON_ADMIN_LOGIN=admin
RESTON_ADMIN_SENHA=
# Em produção (HTTPS), use true
RESTON_COOKIE_SEGURO=false

# Pasta onde ficam as fotos do cardápio
RESTON_UPLOAD_DIR=./uploads

# Modo demonstração: preenche um banco vazio com dados de exemplo (veja o README). Só em desenvolvimento, nunca em produção.
RESTON_DEMO_ATIVO=false
